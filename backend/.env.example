APP_NAME=基于大模型的网络小说创作与投稿辅助系统
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MySQL 示例：先创建数据库 novel_ai_writer，再执行 database.sql
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/novel_ai_writer?charset=utf8mb4

# 没有真实 Key 时留空，系统自动使用 mock AI
AI_PROVIDER=openai
OPENAI_API_KEY=
